\@writefile{toc}{\contentsline {section}{\numberline {4}Part 3: VCG for the Cheapest Path}{5}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}The problem}{5}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Part 2. Our average profit for each $k$. Each curve peaks near its dashed line, the equilibrium $k = (n-1)/n$. At $k = 1$ (bid the truth) every curve is at $0$.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:2}{{5}{6}{Part 2. Our average profit for each $k$. Each curve peaks near its dashed line, the equilibrium $k = (n-1)/n$. At $k = 1$ (bid the truth) every curve is at $0$}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The road network from Figure 7.3 of the book. Numbers are the true costs. The cheapest path, A$\to $B$\to $E$\to $F (cost $3+1+1=5$), is in orange.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:graph}{{6}{6}{The road network from Figure 7.3 of the book. Numbers are the true costs. The cheapest path, A$\to $B$\to $E$\to $F (cost $3+1+1=5$), is in orange}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}How VCG pays}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces How VCG decides each payment. Notice that a road's own claimed cost is not used in its payment; it only decides if the road is on the path.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:vcgflow}{{7}{7}{How VCG decides each payment. Notice that a road's own claimed cost is not used in its payment; it only decides if the road is on the path}{figure.caption.10}{}}
