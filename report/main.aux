\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Part 2, 100{,}000 auctions per $k$. ``Average overpay'' is the winning bid minus the second-highest bid, at the $k$ closest to equilibrium.}}{4}{table.caption.8}\protected@file@percent }
\newlabel{tab:2}{{3}{4}{Part 2, 100{,}000 auctions per $k$. ``Average overpay'' is the winning bid minus the second-highest bid, at the $k$ closest to equilibrium}{table.caption.8}{}}
