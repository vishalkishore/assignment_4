\@writefile{toc}{\contentsline {section}{\numberline {2}Part 1: Second-Price Auction}{1}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}How we tested it}{2}{subsection.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}A: Average profit for every bid}{2}{subsection.2.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Average profit at $b = v$, one rival. In all nine cases this is the highest profit of any bid. For a truthful rival, maths says the profit should be $v^2/2$, which is $0.02$, $0.125$ and $0.32$. Our numbers match.}}{2}{table.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}B: The rival's bid is fixed}{2}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Part 1A, one rival. Each box is one value $v$ (rows) and one rival strategy (columns). The blue line is our average profit for each bid. The red dashed line is $b = v$.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:1a}{{2}{3}{Part 1A, one rival. Each box is one value $v$ (rows) and one rival strategy (columns). The blue line is our average profit for each bid. The red dashed line is $b = v$}{figure.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Part 1B. What happens when we bid $b = v$ against a fixed rival bid. Our code tried every bid from 0 to 1; in all nine cases no bid gave more profit than $b = v$.}}{3}{table.caption.5}\protected@file@percent }
\newlabel{tab:1b}{{2}{3}{Part 1B. What happens when we bid $b = v$ against a fixed rival bid. Our code tried every bid from 0 to 1; in all nine cases no bid gave more profit than $b = v$}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The two mistakes. If the rival's bid lands in the blue zone, a low bid loses an auction we wanted. If it lands in the orange zone, a high bid wins an auction we did not want. Bidding exactly $v$ makes both zones empty.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:mistakes}{{3}{4}{The two mistakes. If the rival's bid lands in the blue zone, a low bid loses an auction we wanted. If it lands in the orange zone, a high bid wins an auction we did not want. Bidding exactly $v$ makes both zones empty}{figure.caption.3}{}}
